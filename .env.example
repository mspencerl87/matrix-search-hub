# The actual client-server API base URL (not necessarily your server name -
# check https://<server-name>/.well-known/matrix/client, m.homeserver.base_url).
MATRIX_HOMESERVER=https://matrix.example.com

# The domain in your Matrix user IDs (full URL, with scheme), e.g.
# https://example.com for @you:example.com. Only needed if this differs
# from MATRIX_HOMESERVER above (it usually does for any org with its own
# domain) - used solely to discover the OIDC issuer via
# .well-known/matrix/client, which is hosted here, not on the API host.
# Leave blank if your server name and API host are literally the same.
MATRIX_SERVER_NAME=https://example.com

# Public URL this app is reachable at. Must be reachable by every user's
# browser, and its /auth/callback path is what gets registered as the OAuth
# redirect_uri - it must exactly match at login time, so don't change this
# once people have started using the app without also re-registering the
# client (delete data/oauth_client.json to force re-registration).
BASE_URL=https://matrix-search.internal.example.com

# Long random string signing session cookies. Generate with:
#   openssl rand -hex 32
# Keep this stable - changing it logs everyone out.
SESSION_SECRET=

MATRIX_DEVICE_NAME=matrix-search-hub
ELEMENT_URL=https://app.element.io

# OAuth client metadata's client_uri. Defaults to BASE_URL, which is what
# you want in virtually all cases - MAS requires this to share the same
# origin as redirect_uri, so there's little reason to override it.
OAUTH_CLIENT_URI=

# Maximum months of history kept per user, regardless of what search range
# they select - backfill stops past this age and older stored messages get
# pruned in the background. Raising it only affects data going forward.
RETENTION_MONTHS=12

# Comma-separated Matrix user IDs allowed to use the admin panel (/admin.html).
# Supports any number of admins, e.g.:
#   ADMIN_USER_IDS=@admin:example.com,@another.admin:example.com
# Empty by default - nobody has admin access until this is set. Admins are
# just regular users who also appear here; admin access is metadata/ops
# only (who's registered, lock/deprovision) and can never read anyone's
# actual messages or bypass their vault passphrase.
ADMIN_USER_IDS=@admin:example.com

# Only set these if your identity provider has no OAuth dynamic client
# registration endpoint and an admin registered this app as a client by
# hand. Otherwise leave blank - the app registers itself automatically on
# first startup and caches the result in data/oauth_client.json.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
